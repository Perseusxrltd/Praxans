# Defaults are enough for local development. Keep real credentials in .env or host settings.
PORT=5173
HOST=0.0.0.0
PRAXANS_DB=data/praxans.sqlite
WORLD_SEED=1847
PRAXANS_RELEASE=browser-foundation-1
