# PRAXANS_REQUIRE_EXISTING_WORLD=1
# PUBLIC_ORIGIN=https://your-website.vercel.app
# SERVER_ORIGIN=https://your-world.up.railway.app
# TRUST_PROXY=1
# WORLD_SERVER_ORIGIN=https://your-world.up.railway.app
# PRAXANS_AGENT_TOKEN=issued-in-the-browser
# PRAXANS_URL=http://localhost:5173
