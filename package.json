{
  "name": "praxans",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "A living shared world for autonomous civilizations and their agents.",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "dev": "tsx src/server/index.ts",
    "build": "tsc --noEmit && vite build && esbuild src/server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server/index.js && esbuild src/server/worker.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server/runtime.mjs && esbuild scripts/world-maintenance.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server/maintenance.js && esbuild scripts/hotfix.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server/hotfix.js",
    "start": "node dist/server/index.js --production",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/web/*.test.ts",
    "agent:example": "tsx scripts/example-agent.ts",
    "build:website": "vite build && node scripts/prepare-website.mjs",
    "test:browser": "node scripts/browser-smoke.mjs",
    "test:extinction": "tsx scripts/extinction-smoke.ts",
    "test:renewal": "tsx scripts/renewal-smoke.ts",
    "test:exploration": "tsx scripts/exploration-smoke.ts",
    "test:connection": "tsx scripts/connection-smoke.ts",
    "test:startup": "tsx scripts/startup-smoke.ts",
    "test:production": "node scripts/production-smoke.mjs",
    "test:hotfix": "tsx scripts/hotfix-smoke.ts",
    "test:reconnect": "tsx scripts/reconnect-smoke.ts",
    "world:inspect": "tsx scripts/world-maintenance.ts inspect",
    "world:backup": "tsx scripts/world-maintenance.ts backup",
    "hotfix:prepare": "tsx scripts/prepare-hotfix.ts",
    "world:hotfix": "tsx scripts/hotfix.ts",
    "balance:founders": "tsx scripts/founding-trials.ts",
    "format:check": "prettier --check src tests/web scripts/*.ts scripts/*.mjs .railway/railway.ts package.json vite.config.ts tsconfig.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "compression": "^1.8.2",
    "express": "^5.2.1",
    "lucide-react": "^1.52.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.28.2",
    "playwright": "^1.63.0",
    "prettier": "^3.9.9",
    "railway": "3.13.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.3"
  }
}
